                "schema": {
                  "type": "string"
                },
                "example": "JSESSIONID=3DD3C6E79BA75874414D08F620981A38; Path=/3dpassport; Secure; HttpOnly; SameSite=None"
              },
              "Keep-Alive": {
                "schema": {
                  "type": "string"
                },
                "example": "timeout=5, max=100"
              },
